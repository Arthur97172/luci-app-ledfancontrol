#
# uci-defaults script - executed exactly once, on the first boot after the
# package has been installed. Exiting with 0 makes the OpenWrt build system
# delete this script again, so it never runs twice.
#
# The factory-pwm backend package normally ships /etc/config/factory_pwm
# itself. This script only covers the case where the UI is installed without
# it - for instance while the backend is still being rebuilt - so that the
# form opens on the documented defaults instead of an empty page. An existing
# configuration is never touched.
#
# Simplified Chinese is deliberately absent here. It ships in the separate
# luci-i18n-ledfancontrol-zh-cn package, whose own uci-defaults - generated by
# luci.mk - registers 简体中文 in luci.languages. Registering it from this
# package instead would offer a language whose catalog is not installed, and
# selecting it would silently show English.

# Both heredocs below are plain << rather than <<- . The difference matters:
# <<- strips *every* leading tab from the body, so the generated file would come
# out flat, while plain << keeps them and the file ends up indented the way uci
# writes its own. The only cost is that the terminating EOF must sit at column 0.
[ -f /etc/config/factory_pwm ] || cat > /etc/config/factory_pwm <<'EOF'
	config factory_led 'led'
		option led_mode 'auto'
		option led_color 'blue'
		option led_effect 'on'
		option brightness '100'

	config factory_fan 'fan'
		option fan_mode 'auto'
		option min_rpm '1500'
		option manual_rpm '2500'
EOF

# The generic backend's own configuration. The LED device is left empty on
# purpose: the daemon then touches nothing, rather than guessing at a LED name
# that may or may not be the one the user means. The page offers the list of
# names the kernel actually has, and picking one is the user's decision.
#
# fan hwmon is matched by name, never by hwmon index - see the daemon's header
# for why. 'pwmfan' is the name the kernel's own pwm-fan driver reports, which
# makes it the right default on any board that uses it.
[ -f /etc/config/ledfancontrol ] || cat > /etc/config/ledfancontrol <<'EOF'
	config led 'led'
		option device ''
		option mode 'auto'
		option effect 'on'
		option color 'blue'
		option brightness '100'

	config fan 'fan'
		option mode 'auto'
		option hwmon 'pwmfan'
		option min_pwm '30'
		option manual_pwm '60'
		option min_temp '40'
		option max_temp '90'
		option overtemp '100'
EOF

exit 0
